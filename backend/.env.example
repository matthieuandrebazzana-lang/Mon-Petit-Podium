ENVIRONMENT=development

# URL du frontend deploye. Sur Railway, mettre l URL Vercel exacte,
# sans barre oblique finale. Cette valeur est deja celle par defaut cote code :
# l origine de production reste autorisee meme si la variable n est pas definie.
FRONTEND_URL=https://mon-petit-podium.vercel.app

# Origines supplementaires eventuelles (preproduction, domaine personnalise),
# separees par des virgules. Le localhost Vite est deja autorise par defaut.
CORS_ORIGINS=

# --- Supabase -----------------------------------------------------------------
# Tableau de bord Supabase > Project Settings > API.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Cle publique (anon). Sert uniquement a valider le jeton de l appelant.
SUPABASE_ANON_KEY=

# Cle de service (service_role). Elle contourne la RLS : elle ne doit JAMAIS
# etre exposee au frontend ni committee. A definir sur Railway uniquement.
SUPABASE_SERVICE_ROLE_KEY=
