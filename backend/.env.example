ENVIRONMENT=development

# URL du frontend deploye. Sur Railway, mettre l URL Vercel exacte,
# sans barre oblique finale.
FRONTEND_URL=https://mon-petit-podium.vercel.app

# Origines supplementaires eventuelles (preproduction, domaine personnalise),
# separees par des virgules. Le localhost Vite est deja autorise par defaut.
CORS_ORIGINS=
