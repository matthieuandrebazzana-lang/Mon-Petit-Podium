# Copier en .env.local et renseigner les valeurs du projet.
# .env.local n'est jamais versionné ; sur Vercel, ces variables se définissent
# dans les réglages du projet (Settings puis Environment Variables).

# Supabase — Project Settings puis API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Backend FastAPI. Vide en local : http://localhost:8000 est la valeur par défaut.
VITE_API_URL=

# ATTENTION — RIEN DE SECRET NE DOIT PORTER LE PRÉFIXE VITE_.
# Vite remplace les VITE_* par leur valeur littérale à la construction : elles
# partent en clair dans le bundle JavaScript public. Les trois variables
# ci-dessus sont publiques par conception (la clé anon est faite pour être
# exposée, c'est la RLS qui protège ; l'URL Railway est publique).
#
# VITE_ADMIN_SECRET a été retiré à la version 0.64.0 pour cette raison : les
# actions d'administration passent désormais par POST /admin/action, fermée par
# le jeton Supabase du membre et une relecture de is_admin en base. ADMIN_SECRET
# reste défini sur Railway seulement, et ne quitte plus jamais le serveur.
