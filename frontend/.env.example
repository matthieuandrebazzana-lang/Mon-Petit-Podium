# Copier en .env.local et renseigner les valeurs du projet.
# .env.local n'est jamais versionné ; sur Vercel, ces variables se définissent
# dans les réglages du projet (Settings puis Environment Variables).

# Supabase — Project Settings puis API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Backend FastAPI. Vide en local : http://localhost:8000 est la valeur par défaut.
VITE_API_URL=
