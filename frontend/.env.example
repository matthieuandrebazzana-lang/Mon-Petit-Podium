# Copier en .env.local et renseigner les valeurs du projet.
# .env.local n'est jamais versionné ; sur Vercel, ces variables se définissent
# dans les réglages du projet (Settings puis Environment Variables).

# Supabase — Project Settings puis API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Backend FastAPI. Vide en local : http://localhost:8000 est la valeur par défaut.
VITE_API_URL=

# Secret partagé des routes d'administration du backend (en-tête X-Admin-Secret).
# Doit valoir EXACTEMENT la variable ADMIN_SECRET définie sur Railway, sans quoi
# les boutons de la section « Administration » du profil reçoivent un 401.
#
# ATTENTION : Vite inline les VITE_* dans le bundle public. Ce secret est donc
# lisible par quiconque ouvre les outils de développement — voir frontend/src/config.js.
VITE_ADMIN_SECRET=
